# Copy to .env and fill in the password.
MONGODB_URI=mongodb+srv://dominhtrung2k:<db_password>@cluster0.bu9h9jq.mongodb.net/?appName=Cluster0
MONGODB_DB=English
PORT=3000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<random-secret>
JWT_EXPIRES_IN=7d

# OpenAI for vocabulary auto-fill (optional; without it the free dictionary is used)
OPENAI_API_KEY=<your-openai-key>
OPENAI_MODEL=gpt-4o-mini
# Auto-fills per user per day that reach OpenAI / online dictionaries (library words are always free)
AUTOFILL_DAILY_LIMIT=3
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Words per user per day that course owners can generate with AI
COURSE_AI_DAILY_LIMIT=30

# Chatbot: messages per user per day (default 30); CHAT_FAKE=1 answers with canned text (no OpenAI) for testing.
CHAT_DAILY_LIMIT=30
CHAT_FAKE=0
# Chatbot uses Claude: set ANTHROPIC_API_KEY; model defaults to claude-haiku-4-5
ANTHROPIC_API_KEY=<your-anthropic-key>
# CHAT_MODEL=claude-haiku-4-5

# Admins (comma separated), made admin at start-up
ADMIN_EMAILS=trung@gmail.com
# Email (sign-up codes, password reset).
# On Render (the free plan blocks SMTP ports) use Brevo: brevo.com → verify your Gmail as a sender → SMTP & API → API keys.
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM=Wordbook <you@gmail.com>   (the sender verified in Brevo)
# On Render (the free plan blocks SMTP ports) use Resend: resend.com → API Keys. When set, SMTP_* are ignored.
# MAIL_FROM must use a domain verified in Resend; without one, leave it unset (onboarding@resend.dev, delivers only to your own Resend email).
# RESEND_API_KEY=re_...
# Without SMTP_USER/SMTP_PASS the code is only written to the server log.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465   # or 587 (STARTTLS)
SMTP_USER=you@gmail.com
SMTP_PASS=<gmail-app-password>
MAIL_FROM=Wordbook <you@gmail.com>
